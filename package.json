{
  "name": "hero",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "typecheck": "pnpm --dir packages/schema typecheck && pnpm --dir packages/engine typecheck && pnpm --dir packages/content typecheck && pnpm --dir apps/web typecheck",
    "test": "pnpm --dir packages/engine test && pnpm --dir apps/web test",
    "lint": "pnpm --dir apps/web lint && eslint packages/engine/src packages/schema/src packages/content/src",
    "validate:scenario": "tsx packages/schema/src/cli.ts",
    "schema:scenario": "tsx packages/schema/src/export-schema.ts",
    "simulate:scenario": "tsx scripts/simulate-scenarios.ts",
    "analyze:hp-balance": "tsx scripts/analyze-hp-balance.ts",
    "e2e": "playwright test",
    "e2e:setup": "tsx e2e/setup-local.ts",
    "check:scenario-promotion": "tsx scripts/check-scenario-promotion.ts",
    "check:mvp-readiness": "node scripts/check-mvp-readiness.mjs",
    "promote:scenario": "tsx scripts/promote-scenario.ts"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "@axe-core/playwright": "4.13.0"
  },
  "type": "module"
}
